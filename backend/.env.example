APP_NAME=BOOKLY
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (Supabase Pooler for runtime or Direct Connection)
# Ejemplo Supavisor Transaction Pooler (puerto 6543, IPv4 compatible):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Conexion directa recomendada para migraciones Alembic (puerto 5432):
DIRECT_DATABASE_URL=

# Configuracion de pool: "auto" | "transaction" | "queue"
DB_POOL_MODE=auto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Supabase Auth & Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Opcional: solo si el proyecto Supabase usa firma legacy HS256 en lugar de JWKS (RS256/ES256)
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Buckets de Supabase Storage
SUPABASE_BUCKET_COVERS=book-covers
SUPABASE_BUCKET_IMAGES=book-images
SUPABASE_BUCKET_AVATARS=avatars

# Seguridad y CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=120/minute
LOG_LEVEL=INFO
